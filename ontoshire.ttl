# Ontoshire publishing manifest — a MIRROR.
#
# This repository contains no RDF. OWL-Time — Time Ontology in OWL is published by
# somebody else; the manifest names their canonical URL and Ontoshire fetches
# it unchanged at publish time. Nothing here is a fork, and nothing here is
# maintained by Ontoshire.
#
# Source:  https://www.w3.org/2006/time
# Licence: W3C Document Licence — https://www.w3.org/copyright/document-license-2023/

@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<> a dcat:Catalog ;
    dcat:dataset <#onto> .

<#onto> a dcat:Dataset ;
    dcterms:title "OWL-Time — Time Ontology in OWL" ;
    dcterms:identifier <http://www.w3.org/2006/time> ;
    dcterms:license <https://www.w3.org/copyright/document-license-2023/> ;
    dcat:distribution [ dcat:downloadURL <https://www.w3.org/2006/time> ] .
